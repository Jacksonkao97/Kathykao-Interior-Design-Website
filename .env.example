# Public URL of the deployed site (used for canonical URLs, sitemap and Open Graph).
NEXT_PUBLIC_SITE_URL=https://kathykao-design.web.app

# WhatsApp number in international format, digits only (no +, spaces or dashes).
NEXT_PUBLIC_WHATSAPP_NUMBER=85200000000

# Optional: base URL for project images and 3D models in Firebase Storage,
# e.g. https://firebasestorage.googleapis.com/v0/b/<bucket>/o
NEXT_PUBLIC_ASSET_BASE_URL=
